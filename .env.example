# Public project URL and publishable key; safe for the browser with RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=gpt-5.6-terra
RESEARCH_BATCH_SIZE=5
RESEARCH_CONCURRENCY=2
RESEARCH_MAX_JOBS_PER_DAY=25
RESEARCH_COVERAGE_THRESHOLD=60
CRON_SECRET=replace_with_random_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
